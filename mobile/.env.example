# Projeto Supabase usado pelo app (valores públicos: a segurança vem da RLS).
# Local: `npx supabase status` mostra API_URL e PUBLISHABLE_KEY.
# No celular com Expo Go, use o IP da máquina na rede (ex.: http://192.168.0.10:54321)
# ou a URL do projeto cloud (https://<ref>.supabase.co).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Duração máxima da filmagem na câmera (segundos). Vídeos curtos de uma única
# prateleira dão contagens melhores; vídeos da galeria aceitam até 60 s.
# EXPO_PUBLIC_MAX_VIDEO_SECONDS=30
