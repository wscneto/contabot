# Usa o login do Codex CLI com sua assinatura ChatGPT.
# Execute: codex login
CONTABOT_PROVIDER=codex
CONTABOT_MODEL=gpt-5.5
CONTABOT_CODEX_COMMAND=codex
CONTABOT_DATA_DIR=data

# Limite combinado: frames do vídeo + fotos de referência.
CONTABOT_MAX_IMAGES=16
CONTABOT_MAX_FRAMES=5
# Após reconhecer produtos, incluir ângulos vizinhos para contar.
CONTABOT_MAX_COUNT_FRAMES=10
CONTABOT_SAMPLE_HZ=1
CONTABOT_MAX_CANDIDATES=120
CONTABOT_MAX_DURATION_SECONDS=180
CONTABOT_MAX_UPLOAD_MB=200
CONTABOT_API_TIMEOUT=180

# Para demonstração sem modelo, use CONTABOT_PROVIDER=mock.
# Para API cobrada separadamente, use CONTABOT_PROVIDER=responses.
CONTABOT_ENDPOINT=https://api.openai.com/v1/responses
OPENAI_API_KEY=
# Parâmetros abaixo aplicam-se somente ao adaptador Responses.
CONTABOT_MAX_OUTPUT_TOKENS=4000
CONTABOT_PROVIDER_PARAMETERS={}
