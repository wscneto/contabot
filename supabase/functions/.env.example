# Secrets das Edge Functions (modelo visual).
# Local:  cp supabase/functions/.env.example supabase/functions/.env
#         npx supabase functions serve --env-file supabase/functions/.env
# Cloud:  npx supabase secrets set --env-file supabase/functions/.env

# chat = qualquer API compatível com OpenAI Chat Completions; mock = simulação.
VISION_PROVIDER=mock
VISION_MOCK_DELAY_MS=1500

# DeepInfra (provedor escolhido; modelos abertos de visão):
# VISION_PROVIDER=chat
# VISION_API_URL=https://api.deepinfra.com/v1/openai/chat/completions
# VISION_MODEL=Qwen/Qwen3-VL-235B-A22B-Instruct
# VISION_API_KEY=
# VISION_RESPONSE_FORMAT=json_object

# Exemplo OpenAI:
# VISION_PROVIDER=chat
# VISION_API_URL=https://api.openai.com/v1/chat/completions
# VISION_MODEL=gpt-5.6-luna
# VISION_API_KEY=sk-...
# VISION_TOKEN_LIMIT_PARAM=max_completion_tokens   # modelos de raciocínio da OpenAI
# VISION_RESPONSE_FORMAT=json_schema               # json_object ou none se o provedor não suportar
# VISION_MAX_IMAGES=16
# VISION_MAX_COUNT_FRAMES=10
# VISION_MAX_OUTPUT_TOKENS=4000
# VISION_TIMEOUT_SECONDS=120
# VISION_EXTRA_PARAMS={"temperature":0}
